# EnMKit platform, self-hosted by 2ME-TECH (horus-lab.com sub-domains).
# These are already the defaults in src/lib/links.ts: set them only to point
# elsewhere (e.g. a staging server), in `.env` or in Vercel > Settings > Environment.
# Set VITE_DASHBOARD_URL to an empty value to hide every "Espace plateforme" entry.
VITE_DASHBOARD_URL=https://dashboard.enmkit.horus-lab.com
VITE_API_URL=https://api.enmkit.horus-lab.com
