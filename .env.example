# EnMKit platform, self-hosted by 2ME-TECH. Hostnames are not final yet:
# replace the placeholders below, then copy this file to `.env` (or set the
# variables in the hosting provider, e.g. Vercel > Settings > Environment).
# Leave VITE_DASHBOARD_URL empty to hide every "Espace plateforme" entry.
VITE_DASHBOARD_URL=https://app.example-2metech.org
VITE_API_URL=https://api.example-2metech.org
